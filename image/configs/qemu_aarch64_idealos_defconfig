# QEMU aarch64 "virt" machine, booted with -kernel (no bootloader).
# Same CPU tuning as the Pi 4 (Cortex-A72) so one set of binaries runs on both.
BR2_aarch64=y
BR2_cortex_a72=y
# The cross-toolchain (GCC 15, glibc, Linux 6.12 headers) is built once and shared by
# every board: tools/build-toolchain installs it in the build VM. Building it in each
# board's tree cost ~7 GB apiece and much of a fresh build. Changing it means
# rebuilding every board from scratch: tools/build-image BOARD clean all.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(HOME)/toolchains/idealos-aarch64"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_12=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# glibc dropped Sun RPC (it lives in libtirpc now); Buildroot checks this claim.
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_IDEALOS_PATH)/board/common/patches"

BR2_TARGET_GENERIC_HOSTNAME="idealos"
BR2_TARGET_GENERIC_ISSUE="idealos (Phase 0, QEMU)"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IDEALOS_PATH)/board/common/busybox.fragment"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IDEALOS_PATH)/board/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IDEALOS_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IDEALOS_PATH)/board/qemu/post-image.sh"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
# Not yet built: confirm this kernel version on the first build.
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.58"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IDEALOS_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_IDEALOS_PATH)/board/qemu/linux.fragment"
# arm64 defconfig builds certs/extract-cert, which needs OpenSSL headers on the build host.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Graphics: lavapipe (software Vulkan) always works on plain virtio-gpu;
# virgl gives accelerated GLES when the host provides it (UTM).
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
# lavapipe needs LLVM, which is most of the build time.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# wgpu loads Vulkan through the loader (libvulkan.so.1), which finds the driver.
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
# Keymap data (/usr/share/X11/xkb) for xkbcommon; it needs no X server.
BR2_PACKAGE_XKEYBOARD_CONFIG=y
# libinput needs udev, and eudev needs the matching /dev management mode.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y

# Dev image extras.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_E2FSPROGS=y

# Networking (M7): NetworkManager joins wired and Wi-Fi networks (Wi-Fi through
# wpa_supplicant), and netd drives it over D-Bus. NetworkManager runs DHCP itself,
# so there's no BR2_SYSTEM_DHCP. Its state and saved networks live on /data
# (post-build.sh links them there).
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WIRELESS_REGDB=y

BR2_PACKAGE_IDEALOS_USERSPACE=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="root-a"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y

# Read-only root; session owns the console instead of a getty.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
# The compositor shapes text with cosmic-text, which panics with no fonts installed.
# Bundled fonts are still an open M1 item; DejaVu covers it until then.
BR2_PACKAGE_DEJAVU=y
