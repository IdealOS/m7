# The cross-toolchain every board's image is built with: GCC 15, glibc and Linux
# 6.12 headers. tools/build-toolchain builds it once (make sdk) and installs it in
# the build VM at ~/toolchains/idealos-aarch64; each board config points at it as an
# external toolchain, so board builds don't each build GCC again (~7 GB of build
# tree apiece). Nothing here is an image: no init, shell or packages.
BR2_aarch64=y
# The lowest CPU among the boards (the Pi 3's), so the C and C++ runtime libraries
# copied into each image run on all of them. Each board's own -mcpu (Cortex-A72 for
# the Pi 4 and QEMU) is added by Buildroot's toolchain wrapper.
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_12=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
