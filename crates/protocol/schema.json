{
  "$comment": "Generated from crates/protocol by crates/protocol-schema; do not edit. Run `make protocol`.",
  "$defs": {
    "AdoptApp": {
      "additionalProperties": false,
      "description": "An app's connection: its messages are stamped with this reverse-DNS app id.",
      "properties": {
        "app": {
          "type": "string"
        }
      },
      "required": [
        "app"
      ],
      "type": "object"
    },
    "AdoptParams": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdoptApp"
        },
        {
          "$ref": "#/$defs/AdoptSystem"
        }
      ],
      "description": "Params of `adopt`, with which session hands the broker one end of a socket\npair (the request's one descriptor) and says what the connection is."
    },
    "AdoptResult": {
      "description": "Result of `adopt`: the new connection's number.",
      "properties": {
        "conn": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "conn"
      ],
      "type": "object"
    },
    "AdoptSystem": {
      "additionalProperties": false,
      "description": "A system service's connection: it may claim names and tap the bus.",
      "properties": {
        "trust": {
          "$ref": "#/$defs/SystemTrust"
        }
      },
      "required": [
        "trust"
      ],
      "type": "object"
    },
    "BrokerErrorCode": {
      "description": "Error codes the broker itself sends. Services may send their own.",
      "oneOf": [
        {
          "const": "bad_request",
          "description": "The frame was valid JSON but the message makes no sense (unknown method, bad params)."
        },
        {
          "const": "no_such_service",
          "description": "No connection has claimed the name the request was sent to."
        },
        {
          "const": "name_taken",
          "description": "Another connection already holds the name."
        },
        {
          "const": "permission_denied",
          "description": "The permission hook refused the message."
        },
        {
          "const": "timeout",
          "description": "The service didn't answer within the request's timeout."
        },
        {
          "const": "service_gone",
          "description": "The service disconnected before answering."
        },
        {
          "const": "limit_exceeded",
          "description": "The connection is at one of the broker's per-connection limits (pending requests, subscriptions or names)."
        }
      ]
    },
    "BusError": {
      "description": "Why a request failed. `code` is one of the broker's codes or a service's own.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Commit": {
      "description": "Params of a `compositor.commit` request.",
      "properties": {
        "ops": {
          "items": {
            "$ref": "#/$defs/SceneOp"
          },
          "type": "array"
        },
        "window": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "window",
        "ops"
      ],
      "type": "object"
    },
    "CreateParams": {
      "description": "Params of `create`.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Direction": {
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "Doc": {
      "description": "A stored document.",
      "properties": {
        "created": {
          "description": "When it was created, in milliseconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        },
        "data": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "description": "A UUIDv7, so ids sort by creation time.",
          "type": "string"
        },
        "type": {
          "description": "The document's type, such as `Email`.",
          "type": "string"
        },
        "updated": {
          "description": "When it last changed, in milliseconds since the Unix epoch.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "created",
        "updated",
        "data"
      ],
      "type": "object"
    },
    "DocsResult": {
      "description": "Result of `query` and `search`.",
      "properties": {
        "docs": {
          "items": {
            "$ref": "#/$defs/Doc"
          },
          "type": "array"
        }
      },
      "required": [
        "docs"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "Result of `hello`: who the broker says this connection is.",
      "properties": {
        "conn": {
          "description": "This connection's number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sender": {
          "$ref": "#/$defs/Sender",
          "description": "How the broker stamps this connection's messages."
        }
      },
      "required": [
        "conn",
        "sender"
      ],
      "type": "object"
    },
    "IdParams": {
      "description": "Params of `get` and `delete`.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ListResult": {
      "description": "Result of `list`.",
      "properties": {
        "connections": {
          "description": "How many connections the broker has.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "services": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Each claimed service name and the connection that holds it.",
          "type": "object"
        }
      },
      "required": [
        "services",
        "connections"
      ],
      "type": "object"
    },
    "Message": {
      "description": "One bus frame's JSON.",
      "oneOf": [
        {
          "properties": {
            "fds": {
              "description": "How many file descriptors travel with this message (see `unix`).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sender"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "request",
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "params": {
              "default": null
            },
            "timeout_ms": {
              "description": "Overrides `DEFAULT_TIMEOUT_MS`.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "to",
            "method"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BusError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fds": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "response",
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "result": true
          },
          "required": [
            "kind",
            "id",
            "ok"
          ],
          "type": "object"
        },
        {
          "description": "The requester no longer wants the answer to request `id`. The broker\nforwards it to the service and drops the response if one still comes.",
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "`topic` is an exact topic, or a prefix ending in `.*` (see\n`topic_matches`). The broker answers with a response carrying `id`.",
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "subscribe",
              "type": "string"
            },
            "topic": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "topic"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "unsubscribe",
              "type": "string"
            },
            "topic": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "topic"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "default": null
            },
            "fds": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sender"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "publish",
              "type": "string"
            },
            "topic": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "topic"
          ],
          "type": "object"
        }
      ]
    },
    "NameParams": {
      "description": "Params of `claim` and `release`.",
      "properties": {
        "name": {
          "description": "A service name: lowercase letters, digits, `-` and `.`.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NodeKind": {
      "description": "Node types understood by the compositor. Phase 0 renders the primitives\n(`rect`, `text`, `group`); widgets arrive in M4 and M5.",
      "enum": [
        "group",
        "rect",
        "text",
        "image",
        "vstack",
        "hstack",
        "label",
        "button"
      ],
      "type": "string"
    },
    "OrderBy": {
      "description": "A sort key: a field path and a direction, written `[\"date\", \"desc\"]`.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Direction"
        }
      ],
      "type": "array"
    },
    "Query": {
      "description": "A query: documents of one type that match a filter, in order.",
      "properties": {
        "limit": {
          "description": "At most this many documents (default 100, at most 10,000).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Skip this many matching documents first.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "orderBy": {
          "description": "Sort keys, most significant first. Ties keep creation order.",
          "items": {
            "$ref": "#/$defs/OrderBy"
          },
          "type": "array"
        },
        "type": {
          "type": "string"
        },
        "where": {
          "additionalProperties": true,
          "description": "Field paths mapped to a value to equal or an object of operators (`$eq`,\n`$ne`, `$gt`, `$gte`, `$lt`, `$lte`, `$in`, `$nin`, `$exists`, `$contains`),\nplus `$and`, `$or` and `$not`. Empty matches every document of the type.",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "SceneOp": {
      "description": "One change to a window's scene graph.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "create",
              "type": "string"
            },
            "props": {
              "additionalProperties": true,
              "default": {},
              "type": "object"
            },
            "type": {
              "$ref": "#/$defs/NodeKind"
            }
          },
          "required": [
            "op",
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Merge `props` into the node's existing props.",
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "set",
              "type": "string"
            },
            "props": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "required": [
            "op",
            "id",
            "props"
          ],
          "type": "object"
        },
        {
          "properties": {
            "child": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "insert",
              "type": "string"
            },
            "parent": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "parent",
            "child",
            "index"
          ],
          "type": "object"
        },
        {
          "properties": {
            "child": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "remove",
              "type": "string"
            },
            "parent": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "parent",
            "child"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "destroy",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "events": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "listen",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "events"
          ],
          "type": "object"
        }
      ]
    },
    "SearchParams": {
      "description": "Params of `search`: documents containing every word of `text`, best first.",
      "properties": {
        "limit": {
          "description": "At most this many (default 100, at most 10,000).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "type": {
          "description": "Only documents of this type.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Sender": {
      "description": "Who sent a message, as stamped by the broker.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A system service that claimed a well-known name such as `db`.",
          "properties": {
            "service": {
              "type": "string"
            }
          },
          "required": [
            "service"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An app, identified by its app id and bus connection number.",
          "properties": {
            "app": {
              "properties": {
                "app": {
                  "type": "string"
                },
                "conn": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "app",
                "conn"
              ],
              "type": "object"
            }
          },
          "required": [
            "app"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A trusted local connection (a tool such as `osctl`, or a service before it\nclaims a name), identified by its bus connection number.",
          "properties": {
            "conn": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "conn"
          ],
          "type": "object"
        }
      ]
    },
    "SystemTrust": {
      "description": "The one trust level `adopt` names explicitly.",
      "enum": [
        "system"
      ],
      "type": "string"
    },
    "TapEvent": {
      "description": "The data of each publish on the tap topic: one message the broker received.",
      "properties": {
        "bus_id": {
          "description": "For a request the broker forwards: the id the service sees and answers\nwith, to match the request to its response in the trace.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "conn": {
          "description": "The connection the message came from.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "msg": {
          "$ref": "#/$defs/Message",
          "description": "The message as the connection sent it (before the broker rewrote its id)."
        },
        "sender": {
          "$ref": "#/$defs/Sender",
          "description": "How the broker stamped it."
        }
      },
      "required": [
        "conn",
        "sender",
        "msg"
      ],
      "type": "object"
    },
    "UpdateParams": {
      "description": "Params of `update`: a JSON merge patch (RFC 7396) for document `id`. A key set\nto null is removed, an object merges into the object there, and anything else\nreplaces the old value.",
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "id",
        "patch"
      ],
      "type": "object"
    }
  },
  "$id": "idealos:protocol",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bus frames are a 4-byte big-endian length followed by one UTF-8 JSON `Message`.",
  "title": "idealos wire protocol",
  "x-constants": {
    "BROKER": {
      "description": "The broker's own name: `hello`, `claim`, `release` and `list` go to it, and `adopt`, with which session hands it connections for services and apps.",
      "value": "bus"
    },
    "DB_SERVICE": {
      "description": "The name the database service claims.",
      "value": "db"
    },
    "DEFAULT_QUERY_LIMIT": {
      "description": "The `limit` a query gets when it names none.",
      "value": 100
    },
    "DEFAULT_TIMEOUT_MS": {
      "description": "How long the broker waits for a response before answering `timeout` itself, unless the request sets `timeout_ms`.",
      "value": 30000
    },
    "MAX_FDS_PER_MESSAGE": {
      "description": "Most file descriptors one message may carry.",
      "value": 16
    },
    "MAX_FRAME_BYTES": {
      "description": "Largest frame the broker accepts, not counting the 4-byte length prefix.",
      "value": 4194304
    },
    "MAX_NAMES": {
      "description": "Most service names one connection may claim.",
      "value": 64
    },
    "MAX_PENDING_REQUESTS": {
      "description": "Most requests one connection may have waiting for an answer at once; past it the broker answers `limit_exceeded`.",
      "value": 1024
    },
    "MAX_QUERY_LIMIT": {
      "description": "Most documents one query returns; a larger `limit` is an error.",
      "value": 10000
    },
    "MAX_SUBSCRIPTIONS": {
      "description": "Most subscription patterns one connection may hold.",
      "value": 256
    },
    "MAX_TIMEOUT_MS": {
      "description": "Longest `timeout_ms` the broker honors; longer ones are shortened to this.",
      "value": 3600000
    },
    "TAP_TOPIC": {
      "description": "The broker's trace of every message; only trusted connections may subscribe.",
      "value": "bus.tap"
    }
  }
}
