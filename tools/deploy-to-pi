#!/bin/sh
# Push new device binaries to a running dev image and restart session to run them.
# Usage: tools/deploy-to-pi HOST [PORT]
#   Pi:   tools/deploy-to-pi idealos.local
#   QEMU: tools/deploy-to-pi localhost 2222
# Builds first with tools/build-device-bins; NO_BUILD=1 pushes target/device as is.
# Logs in as root with image/output/dev-key, which tools/build-image bakes in.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${1:?usage: tools/deploy-to-pi HOST [PORT]}"
PORT="${2:-22}"
BIN="$REPO/target/device"
. "$REPO/tools/_device.sh"

[ -n "${NO_BUILD:-}" ] || "$REPO/tools/build-device-bins"

# Binaries go to the writable /opt/idealos overlay; start-session prefers them over
# the copies baked into the read-only image. Write to .new and rename, because a
# running executable can't be overwritten in place. (Dropbear has no SFTP server,
# so plain ssh + cat instead of scp.)
for b in session compositor kms-probe; do
	[ -f "$BIN/$b" ] || { echo "No $BIN/$b. Run tools/build-device-bins."; exit 1; }
	remote "cat > /opt/idealos/bin/$b.new && chmod 755 /opt/idealos/bin/$b.new &&
		mv /opt/idealos/bin/$b.new /opt/idealos/bin/$b" <"$BIN/$b"
done
# session stops its services on SIGTERM; init then respawns it from /opt/idealos/bin.
remote 'kill $(pidof session)'
echo "Deployed to $HOST:$PORT"
