#!/bin/sh
# Build a device image in the idealos-build VM and copy it to image/output/<board>.
# Usage: tools/build-image qemu|rpi3|rpi4 [buildroot make args...]
set -eu
. "$(dirname "$0")/_vm.sh"
BOARD="${1:?usage: tools/build-image qemu|rpi3|rpi4}"
shift
case "$BOARD" in
	qemu) DEFCONFIG=qemu_aarch64_idealos_defconfig ;;
	rpi3) DEFCONFIG=rpi3_idealos_defconfig ;;
	rpi4) DEFCONFIG=rpi4_idealos_defconfig ;;
	*) echo "unknown board: $BOARD"; exit 2 ;;
esac

# Dev images let root log in over SSH with this key (tools/deploy-to-pi uses it).
# The private half stays on this Mac; post-build.sh installs the public half.
KEY="$REPO/image/output/dev-key"
if [ ! -f "$KEY" ]; then
	mkdir -p "$REPO/image/output"
	ssh-keygen -q -t ed25519 -N "" -C idealos-dev -f "$KEY"
fi
cp "$KEY.pub" "$REPO/image/board/common/dev-key.pub"

# Bundle the apps here: the VM has no Node. The image installs apps/*/dist.
node "$REPO/tools/build-app.ts" "$REPO"/apps/*/

vm_require
# Every board builds with the shared cross-toolchain; make it first if it's missing.
vm_run "[ -x ~/toolchains/idealos-aarch64/bin/aarch64-buildroot-linux-gnu-gcc ]" || "$REPO/tools/build-toolchain"
vm_sync
# Source downloads live outside the Buildroot tree so they survive version bumps.
# idealos-userspace is a local package: Buildroot copies it once and never notices
# later edits, so clean it each time to build the repo as it is now.
vm_run "set -e
	cd ~
	export BR2_DL_DIR=\$HOME/br-dl
	if [ ! -d buildroot-$BUILDROOT_VERSION ]; then
		wget -q https://buildroot.org/downloads/buildroot-$BUILDROOT_VERSION.tar.gz
		tar xf buildroot-$BUILDROOT_VERSION.tar.gz
	fi
	make -C buildroot-$BUILDROOT_VERSION O=\$HOME/out/$BOARD BR2_EXTERNAL=\$HOME/idealos/image $DEFCONFIG
	make -C \$HOME/out/$BOARD idealos-userspace-dirclean
	make -C \$HOME/out/$BOARD $*"
vm_fetch "out/$BOARD/images" "$REPO/image/output/$BOARD"
echo "Images in image/output/$BOARD"
