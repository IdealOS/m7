#!/bin/sh
# Create the aarch64 Linux VM that builds device images (needs Lima).
set -eu
command -v limactl >/dev/null || { echo "Lima is not installed. Run: brew install lima"; exit 1; }
if limactl list -q 2>/dev/null | grep -qx idealos-build; then
	echo "VM idealos-build already exists"; limactl start idealos-build 2>/dev/null || true; exit 0
fi
limactl start --tty=false --name=idealos-build "$(dirname "$0")/lima/idealos-build.yaml"
