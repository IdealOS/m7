#!/bin/sh
# Clippy and unit tests for the Linux-only code (the KMS backend and kms-probe's frame
# loop), which `make lint` on macOS can't see, and the bus, whose sockets and peer
# credentials behave differently on Linux. Runs in the build VM with its own target
# directory. Only the KMS tests run for the compositor: the VM has no GPU for the
# renderer's tests.
set -eu
. "$(dirname "$0")/_vm.sh"
vm_require
vm_sync
vm_run "set -e; cd ~/idealos
	rustup component add clippy 2>/dev/null
	CARGO_TARGET_DIR=\$HOME/lint-target cargo clippy --locked \\
		-p compositor --no-default-features --features kms -p kms-probe -p session -p sandbox \\
		-p protocol -p busd -p bus-client -p osctl -p db -p dbd -p permd -p secretsd -p ptyd -p netd -p backupd -p importd -p app-host \\
		--all-targets -- -D warnings
	CARGO_TARGET_DIR=\$HOME/lint-target cargo test --locked -q -p protocol -p busd -p bus-client -p osctl -p session -p sandbox -p db -p dbd -p permd -p secretsd -p ptyd -p netd -p backupd -p importd -p app-host
	CARGO_TARGET_DIR=\$HOME/lint-target cargo test --locked -q \\
		-p compositor --no-default-features --features kms --lib backend::kms"
