#!/bin/sh
# Type-check (strict) and unit-test the TypeScript tools in tools/. TypeScript and
# Node's types come from npx's cache, so nothing is added to the repo.
set -eu
cd "$(dirname "$0")"
npx --yes -p typescript@5.9 -p @types/node@24 sh -c \
	'tsc -p . --typeRoots "$(dirname "$(dirname "$(command -v tsc)")")/@types"'
# A glob, not a directory: Node 24 (as in CI) rejects a directory here.
node --test "*.test.ts"
