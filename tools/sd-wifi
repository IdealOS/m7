#!/bin/sh
# Preset a Wi-Fi network on a flashed Pi SD card (macOS), so the Pi joins it on its
# next boot and can be reached over SSH without a keyboard or Ethernet.
# Usage: tools/sd-wifi /dev/diskN [SSID [PASSWORD]]   Find N with: diskutil list external
#
# Asks for whatever isn't given: the network's name, then its password (not
# echoed). Given only an SSID, it still asks for the password, which keeps it out
# of your shell history and `ps`; pass "" as the password for an open network.
# Writes them to wifi.txt on the card's boot partition. At boot, S05data saves them
# as a NetworkManager profile on /data and deletes wifi.txt. Nothing is kept on this
# Mac. Run it again to switch networks; profiles already saved stay until Forget in
# Settings.
set -eu
DISK="${1:?usage: tools/sd-wifi /dev/diskN [SSID [PASSWORD]] (see: diskutil list external)}"
INFO="$(diskutil info "$DISK")" || exit 1
echo "$INFO" | grep -Eq "Device Location: +External|Removable Media: +(Removable|Yes)" \
	|| { echo "$DISK is not an external or removable disk. Refusing."; exit 1; }

PART="${DISK}s1"
diskutil mount "$PART" >/dev/null 2>&1 || true
MNT="$(diskutil info "$PART" 2>/dev/null | sed -n 's/^ *Mount Point: *//p')"
if [ -z "$MNT" ] || [ ! -d "$MNT" ]; then
	echo "Can't mount the boot partition $PART. Remove the card, put it back, and run this again."
	exit 1
fi
if [ ! -f "$MNT/start4.elf" ] && [ ! -f "$MNT/start.elf" ]; then
	echo "$MNT doesn't look like a Pi boot partition (no start.elf). Flash the card first: tools/flash-sd"
	exit 1
fi

if [ $# -ge 2 ]; then
	SSID="$2"
else
	printf "Wi-Fi network name: "
	IFS= read -r SSID
fi
[ -n "$SSID" ] || { echo "No name given."; exit 1; }
[ "$(printf '%s' "$SSID" | wc -c)" -le 32 ] || { echo "A network name is at most 32 bytes."; exit 1; }
if [ $# -ge 3 ]; then
	PASSWORD="$3"
else
	printf "Password (leave empty for an open network): "
	[ -t 0 ] && stty -echo
	IFS= read -r PASSWORD || true
	[ -t 0 ] && stty echo
	echo
fi
if [ -n "$PASSWORD" ]; then
	len=$(printf '%s' "$PASSWORD" | wc -c | tr -d ' ')
	[ "$len" -ge 8 ] && [ "$len" -le 63 ] || {
		echo "A WPA password is 8 to 63 characters."
		exit 1
	}
fi

# Readable only by this user while it's on the Mac side; FAT has no permissions
# once the card is in the Pi, which is why the Pi deletes it after reading it.
(umask 077 && printf 'ssid=%s\npassword=%s\n' "$SSID" "$PASSWORD" >"$MNT/wifi.txt")
sync
echo "Saved \"$SSID\" to $MNT/wifi.txt. The Pi joins it on its next boot."
diskutil eject "$DISK"
