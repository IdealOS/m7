{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idealos:schema/Track",
  "title": "Track",
  "description": "A piece of music; the audio is a blob.",
  "type": "object",
  "required": ["title", "audio"],
  "properties": {
    "title": { "type": "string" },
    "artist": { "type": "string" },
    "album": { "type": "string" },
    "albumArtist": { "type": "string" },
    "trackNumber": { "type": "integer", "minimum": 0 },
    "discNumber": { "type": "integer", "minimum": 0 },
    "year": { "type": "integer" },
    "genre": { "type": "string" },
    "duration": { "type": "number", "minimum": 0, "description": "Seconds." },
    "audio": { "x-kind": "blob" },
    "artwork": { "x-kind": "blob" },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Stars the listener gave it, 1 to 5; missing when unrated." },
    "playCount": { "type": "integer", "minimum": 0, "description": "Times played to the end." },
    "lastPlayed": { "type": "integer", "description": "When it last played to the end, in milliseconds since the Unix epoch." },
    "replayGain": {
      "type": "object",
      "description": "ReplayGain from the file's tags: dB to turn the track (or its album) by to play at the standard loudness, and its loudest sample (1 is full scale).",
      "properties": {
        "trackGain": { "type": "number" },
        "trackPeak": { "type": "number", "minimum": 0 },
        "albumGain": { "type": "number" },
        "albumPeak": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "x-indexes": ["artist", "album"]
}
