{
  "name": "@idealos/app-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "idealos": {
    "id": "org.idealos.editor",
    "name": "Editor",
    "autostart": false,
    "permissions": [
      { "type": "TextDocument", "access": ["read", "write", "create"] },
      { "type": "Image", "access": ["read"] }
    ]
  },
  "scripts": {
    "build": "node ../../tools/build-app.ts .",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "typescript": "~5.9.0"
  }
}
