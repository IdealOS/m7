#!/bin/sh
# Type-check the Music app (strict) and its tests, and run them. TypeScript and
# Node's types come from npx's cache, so nothing is added to the repo.
set -eu
cd "$(dirname "$0")"
npx --yes -p typescript@5.9 -p @types/node@26 sh -c '
	types="$(dirname "$(dirname "$(command -v tsc)")")/@types"
	tsc -p . &&
	tsc -p test --typeRoots "$types"'
node --test "test/*.test.ts"
